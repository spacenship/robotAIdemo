# 사용할 API: groq 또는 gemini. 실행 중 P 키나 --provider 옵션으로도 바꿀 수 있습니다.
LLM_PROVIDER=groq

# Groq: https://console.groq.com/keys 에서 발급한 키. 따옴표 없이 = 뒤에 입력합니다.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Gemini: https://aistudio.google.com/apikey 에서 발급한 키. Gemini를 쓸 때만 입력합니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

LLM_TIMEOUT_SECONDS=20
MIN_REQUEST_INTERVAL_SECONDS=3
MAX_COMPLETION_TOKENS=1024
